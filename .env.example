# Smart Parking - Edge Capture Service Configuration
SERVICE_PORT=8086
BACKEND_URL=http://localhost:8085
BACKEND_TOKEN=
PARKING_ID=main-parking

# RTSP or Synthetic Mode (true = synthetic/replay when no physical IP cameras are connected)
SYNTHETIC_MODE=true

# Video & Processing Pipeline
DEFAULT_FPS=8
PLATE_CONFIDENCE_THRESHOLD=0.75
OCR_CONFIDENCE_THRESHOLD=0.80
CONSENSUS_MIN_FRAMES=3
RECOGNITION_TIMEOUT_MS=1500

# Barrier & State Machine Timers
COOLDOWN_SEC=5
BARRIER_PASSAGE_TIMEOUT_SEC=15
MAX_FRAME_QUEUE=50
INFERENCE_WORKERS=4

# Storage
STORAGE_BEST_FRAME=true
UPLOAD_DIR=./snapshots
