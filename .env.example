# ==============================================================================
# Smart Parking — Edge Capture Service Configuration
# ==============================================================================

# Application Environment & Server
APP_ENV=production
SERVICE_PORT=8086
LOG_LEVEL=INFO

# Camera Identification & Direction ("entry" or "exit")
CAMERA_ID=entry-01
CAMERA_NAME=Kirish Yo'lagi Kamerasi 01
CAMERA_DIRECTION=entry
PARKING_ID=main-parking

# Video Stream Source ("rtsp" or "file")
VIDEO_SOURCE=rtsp
RTSP_URL=rtsp://admin:password@192.168.1.100:554/Streaming/Channels/101
VIDEO_FILE=/data/test.mp4
TARGET_FPS=10
MAX_FRAME_QUEUE=50

# Region of Interest (ROI) Lane Filtering
ROI_ENABLED=false
ROI_X1=0
ROI_Y1=200
ROI_X2=1920
ROI_Y2=1080

# YOLO Model Paths & Detection Confidence
VEHICLE_MODEL=yolov8n.pt
PLATE_MODEL=yolov8n.pt
VEHICLE_CONFIDENCE=0.40
PLATE_CONFIDENCE=0.45
OCR_MIN_CONFIDENCE=0.60

# Plate Crop Quality Filter
MIN_PLATE_WIDTH=80
MIN_PLATE_HEIGHT=20
MIN_SHARPNESS_SCORE=25.0
OCR_INTERVAL_MS=200

# Multi-Frame Consensus & Tracking
MIN_CONSENSUS_COUNT=2
MIN_FINAL_CONFIDENCE=0.78
TRACK_TIMEOUT_SECONDS=5.0
TRACKER_TYPE=bytetrack

# Deduplication & Cooldown (Debounce)
EVENT_COOLDOWN_SECONDS=10
REDIS_URL=

# Snapshots & Retention Storage
STORAGE_BEST_FRAME=true
UPLOAD_DIR=./snapshots
CAPTURE_RETENTION_DAYS=7

# Central Parking Backend Integration
BACKEND_URL=http://localhost:8085
BACKEND_EVENT_PATH=/api/v1/anpr/event
BACKEND_TOKEN=
BACKEND_TIMEOUT_SECONDS=4.0
BACKEND_MAX_RETRIES=3
BACKEND_QUEUE_SIZE=200
